# ---------------------------------------------------------------- backend
# LLM provider for Live AI mode: anthropic | openai | mock | none
#   none  -> Live AI disabled, the Guided Demo still works
#   mock  -> real LangGraph engine with a scripted model (no key, dev only)
LLM_PROVIDER=none
LLM_MODEL=claude-sonnet-5-5          # required for openai (e.g. your chosen model id)
LLM_EFFORT=low                     # anthropic effort: low | medium | high
LLM_MAX_TOKENS=4096
LLM_CALL_TIMEOUT_S=60

# Secrets: server side only, never exposed to the browser
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Guard rails for the public demo
MAX_ITERATIONS=3                   # correction loops per workflow
QUALITY_THRESHOLD=8.0              # reviewer average (0-10) needed to accept a fix / test suite
MIN_RUBRIC_SCORE=8.0               # and no single rubric criterion below this
WORKFLOW_TIMEOUT_S=180
MAX_LLM_CALLS_PER_WORKFLOW=14
MAX_COST_PER_WORKFLOW_USD=0.50
MAX_CODE_CHARS=6000
MAX_REQUEST_CHARS=1000
MAX_CONCURRENT_WORKFLOWS=3
RATE_LIMIT_PER_IP_PER_HOUR=5
QUOTA_PER_SESSION=2
MAX_LIVE_WORKFLOWS_PER_DAY=50      # global cap on paid runs per UTC day

# Result cache: identical requests replay a previous real run for free
RESULT_CACHE=true
RESULT_CACHE_PATH=                 # default backend/data/result_cache.sqlite
RESULT_CACHE_TTL_DAYS=30
TRUST_PROXY=true

# Comma-separated list of allowed frontend origins (CORS)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# ---------------------------------------------------------------- frontend
# Public URL of the backend, baked in at build time (empty = same origin)
VITE_API_URL=
